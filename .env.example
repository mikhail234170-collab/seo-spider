# Site Lens configuration (copy to .env — never commit .env)

# Host and port for the local web UI
SITE_LENS_HOST=127.0.0.1
SITE_LENS_PORT=8765

# Directory for SQLite database and export files (created automatically)
SITE_LENS_DATA_DIR=./data

# Default crawl limits (can be overridden per crawl in the UI)
SITE_LENS_DEFAULT_MAX_URLS=500
SITE_LENS_DEFAULT_RATE_PER_SEC=2.0

# Playwright rendered-page timeout (milliseconds)
SITE_LENS_RENDER_TIMEOUT_MS=15000
